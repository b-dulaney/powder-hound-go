# Copy to .env.dev and fill in the dev Supabase branch's values (Dashboard -> switch to the
# `dev` branch -> Settings -> API Keys). Run services with ENV_FILE=../.env.dev, or the
# monitor with: go run ./cmd/monitor -env-file .env.dev
ENV=development
REDIS_HOST=localhost
SUPABASE_URL=https://ubdkgzytbwdkdrnbsnne.supabase.co
# The dev branch's sb_secret_... key (the variable keeps its legacy name).
SUPABASE_SERVICE_ROLE_KEY=
# Set to true to log database writes instead of making them. The email service always uses
# the mock outside production, so it never emails dev-branch users.
SUPABASE_MOCK=false
# The development email schedule sends to the mock's test recipient every minute; a Resend
# test key avoids real sends.
RESEND_API_KEY=

# Scraper monitor (optional)
ANTHROPIC_API_KEY=
# GitHub App (issues/PRs come from its bot) - the .pem base64-encoded on one line - or a token.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_REPO=b-dulaney/powder-hound
GITHUB_BASE_BRANCH=dev
MONITOR_ENV=dev
